# Copy to .env and adjust. All vars are prefixed PITWALL_.

# Data source: "fixture" (offline sample, default) or "openf1" (live API)
PITWALL_DATA_SOURCE=fixture
PITWALL_OPENF1_BASE_URL=https://api.openf1.org/v1

# Cache — leave unset for in-memory; set to use Redis
# PITWALL_REDIS_URL=redis://localhost:6379/0

# Database — leave unset to run without persistence; set to use Postgres
# PITWALL_DATABASE_URL=postgresql+asyncpg://pitwall:pitwall@localhost:5432/pitwall

# CORS: JSON list of allowed origins
PITWALL_CORS_ORIGINS=["*"]
PITWALL_LOG_LEVEL=INFO
